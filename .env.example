# Copy selected values into the environment of the process that needs them.
# This file is a template and is not automatically loaded by Spring Boot.

# Config Server: default local sibling repository.
# To read GitHub instead, use the HTTPS URL of your PRIVATE config repository.
CONFIG_GIT_URI=../../ecommerce-config
CONFIG_GIT_LABEL=main
CONFIG_GIT_USERNAME=
CONFIG_GIT_TOKEN=

# Config clients.
CONFIG_SERVER_URL=http://localhost:8888

# Local Docker examples only. Supply real credentials via deployment variables.
INVENTORY_DB_USERNAME=root
INVENTORY_DB_PASSWORD=root
ORDER_DB_USERNAME=admin
ORDER_DB_PASSWORD=admin
PRODUCT_MONGODB_URI=mongodb://root:password@localhost:27017/product-db?authSource=admin
